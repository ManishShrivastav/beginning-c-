{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Single C++ File",
            "type": "cppdbg",
            "request": "launch",

            "program": "${fileDirname}/main.out",
            "args": [],

            "stopAtEntry": true,
            "cwd": "${fileDirname}",
            "externalConsole": false,

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "preLaunchTask": "Build Single C++ File",

            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip C++ standard library headers",
                    "text": "skip -gfi /usr/include/c++/*",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip architecture-specific C++ headers",
                    "text": "skip -gfi /usr/include/*/c++/*",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip system headers",
                    "text": "skip -gfi /usr/include/*",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug C++ Project Folder",
            "type": "cppdbg",
            "request": "launch",

            "program": "${fileDirname}/main.out",
            "args": [],

            "stopAtEntry": true,
            "cwd": "${fileDirname}",
            "externalConsole": false,

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "preLaunchTask": "Build C++ Project Folder",

            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip C++ standard library headers",
                    "text": "skip -gfi /usr/include/c++/*",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip architecture-specific C++ headers",
                    "text": "skip -gfi /usr/include/*/c++/*",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip system headers",
                    "text": "skip -gfi /usr/include/*",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}