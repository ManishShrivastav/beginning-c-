{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Single C++ File",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/main.out"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build C++ Project Folder",
            "type": "shell",
            "command": "clang++ -g *.cpp -o main.out",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}